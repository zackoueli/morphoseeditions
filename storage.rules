rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /issues/{issueId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
